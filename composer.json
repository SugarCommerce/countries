{
  "name": "sugarcommerce/countries",
  "version": "1.3.0",
  "description": "ISO 3166-1 country data: codes, names, emoji flags, EU membership, sanctioned and elevated-risk territories. Zero dependencies.",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/sugarcommerce/countries",
  "authors": [ { "name": "David Sherlock", "homepage": "https://arraypress.com/" } ],
  "keywords": ["countries", "iso-3166", "country-codes", "eu", "vat", "flags", "sanctions"],
  "require": { "php": ">=8.5", "ext-mbstring": "*" },
  "require-dev": { "phpunit/phpunit": "^13.0" },
  "autoload": { "psr-4": { "SugarCommerce\\Countries\\": "src/" } },
  "autoload-dev": { "psr-4": { "SugarCommerce\\Countries\\Tests\\": "tests/" } },
  "scripts": { "test": "phpunit" },
  "config": { "optimize-autoloader": true, "sort-packages": true, "preferred-install": "dist" },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "support": { "issues": "https://github.com/sugarcommerce/countries/issues", "source": "https://github.com/sugarcommerce/countries" }
}
